{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 400,
  "title": "Billionaire Distribution & Wealth Origins (2023)",
  "projection": {
    "type": "equirectangular",
    "center": [115, -15],
    "scale": 450
  },
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/FIT3179/Vega-Lite/main/3_choropleth_map/js/ne_110m_admin_0_countries.topojson",
        "format": {"type": "topojson", "feature": "ne_110m_admin_0_countries"}
      },
      "mark": {
        "type": "geoshape",
        "fill": "#eef2f5",
        "stroke": "#cfd8dc"
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/OwenHee/fit2179-assignment2/main/data/Billionaires%20Statistics%20Dataset.csv"
      },
      "transform": [
        {
          "filter": "datum.countryOfCitizenship == 'Malaysia' || datum.countryOfCitizenship == 'Australia'"
        }
      ],
      "mark": {"type": "circle", "opacity": 0.75, "stroke": "#2c3e50", "strokeWidth": 1},
      "encoding": {
        "longitude": {"field": "longitude_country", "type": "quantitative"},
        "latitude": {"field": "latitude_country", "type": "quantitative"},
        "size": {
          "field": "finalWorth",
          "type": "quantitative",
          "title": "Net Worth ($ Millions)",
          "scale": {"range": [50, 800]}
        },
        "color": {
          "field": "selfMade",
          "type": "nominal",
          "title": "Self-Made Status",
          "scale": {
            "domain": [true, false],
            "range": ["#008080", "#ff7f50"]
          }
        },
        "tooltip": [
          {"field": "personName", "type": "nominal", "title": "Name"},
          {"field": "countryOfCitizenship", "type": "nominal", "title": "Country"},
          {"field": "finalWorth", "type": "quantitative", "title": "Net Worth ($M)"},
          {"field": "category", "type": "nominal", "title": "Industry"}
        ]
      }
    }
  ]
}
