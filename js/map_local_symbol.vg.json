{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 400,
  "title": "Billionaire Distribution & Wealth Origins (2023)",
  "projection": {
    "type": "equirectangular",
    "center": [115, -15],
    "scale": 450
  },
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/FIT3179/Vega-Lite/main/3_choropleth_map/js/ne_110m_admin_0_countries.topojson",
        "format": {"type": "topojson", "feature": "ne_110m_admin_0_countries"}
      },
      "mark": {
        "type": "geoshape",
        "fill": "#eef2f5",
        "stroke": "#cfd8dc"
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/FIT3179/Vega-Lite/main/6_advanced_examples/data/Billionaire.csv"
      },
      "transform": [
        {
          "filter": "datum.Country == 'Malaysia' || datum.Country == 'Australia'"
        }
      ],
      "mark": {"type": "circle", "opacity": 0.75, "stroke": "#2c3e50", "strokeWidth": 1},
      "encoding": {
        "longitude": {"field": "Longitude", "type": "quantitative"},
        "latitude": {"field": "Latitude", "type": "quantitative"},
        "size": {
          "field": "Worth",
          "type": "quantitative",
          "title": "Net Worth ($ Billions)",
          "scale": {"range": [50, 800]}
        },
        "color": {
          "field": "Source",
          "type": "nominal",
          "title": "Wealth Source"
        },
        "tooltip": [
          {"field": "Name", "type": "nominal", "title": "Name"},
          {"field": "Country", "type": "nominal", "title": "Country"},
          {"field": "Worth", "type": "quantitative", "title": "Net Worth ($B)"},
          {"field": "Industry", "type": "nominal", "title": "Industry"}
        ]
      }
    }
  ]
}
