{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 400,
  "title": "Global Billionaire Distribution by Country",
  "projection": {"type": "equalEarth"},
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/FIT3179/Vega-Lite/main/3_choropleth_map/js/ne_110m_admin_0_countries.topojson",
        "format": {"type": "topojson", "feature": "ne_110m_admin_0_countries"}
      },
      "mark": {"type": "geoshape", "fill": "#eef2f5", "stroke": "#cfd8dc"}
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/FIT3179/Vega-Lite/main/6_advanced_examples/data/Billionaires%20Statistics%20Dataset.csv"
      },
      "transform": [
        {
          "aggregate": [{"op": "count", "as": "Count"}],
          "groupby": ["country", "longitude_country", "latitude_country"]
        }
      ],
      "mark": {"type": "circle", "color": "#e06666", "opacity": 0.7},
      "encoding": {
        "longitude": {"field": "longitude_country", "type": "quantitative"},
        "latitude": {"field": "latitude_country", "type": "quantitative"},
        "size": {
          "field": "Count",
          "type": "quantitative",
          "title": "Billionaires Count",
          "scale": {"range": [10, 500]}
        },
        "tooltip": [
          {"field": "country", "type": "nominal", "title": "Country"},
          {"field": "Count", "type": "quantitative", "title": "Total Billionaires"}
        ]
      }
    }
  ]
}
