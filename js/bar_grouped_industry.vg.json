{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 400,
  "title": "Billionaire Industry Concentration: Australia vs Malaysia",
  "data": {
    "url": "https://raw.githubusercontent.com/FIT3179/Vega-Lite/main/6_advanced_examples/data/Billionaire.csv"
  },
  "transform": [
    {
      "filter": "datum.Country == 'Malaysia' || datum.Country == 'Australia'"
    },
    {
      "aggregate": [{"op": "count", "as": "billionaire_count"}],
      "groupby": ["Country", "Industry"]
    }
  ],
  "mark": {"type": "bar", "cornerRadiusTopLeft": 4, "cornerRadiusTopRight": 4},
  "encoding": {
    "x": {
      "field": "Industry",
      "type": "nominal",
      "title": "Industry Category",
      "axis": {"labelAngle": -45}
    },
    "y": {
      "field": "billionaire_count",
      "type": "quantitative",
      "title": "Number of Billionaires"
    },
    "xOffset": {
      "field": "Country",
      "title": "Country"
    },
    "color": {
      "field": "Country",
      "type": "nominal",
      "title": "Country",
      "scale": {
        "domain": ["Australia", "Malaysia"],
        "range": ["#4682b4", "#008080"]
      }
    },
    "tooltip": [
      {"field": "Country", "type": "nominal", "title": "Country"},
      {"field": "Industry", "type": "nominal", "title": "Industry"},
      {"field": "billionaire_count", "type": "quantitative", "title": "Total Billionaires"}
    ]
  }
}
