{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Gender Representation Across Wealth Ecosystems",
  "data": {
    "url": "https://raw.githubusercontent.com/FIT3179/Vega-Lite/main/6_advanced_examples/data/Billionaires%20Statistics%20Dataset.csv"
  },
  "transform": [
    {
      "filter": "datum.gender == 'M' || datum.gender == 'F'"
    },
    {
      "calculate": "datum.countryOfCitizenship == 'Malaysia' ? 'Malaysia' : (datum.countryOfCitizenship == 'Australia' ? 'Australia' : 'Global Baseline')",
      "as": "Ecosystem"
    },
    {
      "aggregate": [{"op": "count", "as": "gender_count"}],
      "groupby": ["Ecosystem", "gender"]
    }
  ],
  "facet": {
    "field": "Ecosystem",
    "type": "nominal",
    "title": null,
    "header": {"labelFontSize": 12, "labelFontWeight": "bold"}
  },
  "spec": {
    "width": 100,
    "height": 250,
    "mark": {"type": "arc", "innerRadius": 35, "outerRadius": 55, "stroke": "#fff"},
    "encoding": {
      "theta": {"field": "gender_count", "type": "quantitative"},
      "color": {
        "field": "gender",
        "type": "nominal",
        "title": "Gender",
        "scale": {
          "domain": ["M", "F"],
          "range": ["#2b5c8f", "#e06666"]
        }
      },
      "tooltip": [
        {"field": "gender", "type": "nominal", "title": "Gender"},
        {"field": "gender_count", "type": "quantitative", "title": "Total Count"}
      ]
    }
  }
}
