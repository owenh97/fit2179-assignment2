{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 380,
  "title": "Billionaire Demographics & Higher Education Access",
  "data": {
    "url": "https://raw.githubusercontent.com/FIT3179/Vega-Lite/main/6_advanced_examples/data/Billionaires%20Statistics%20Dataset.csv"
  },
  "transform": [
    {
      "filter": "datum.gross_tertiary_education_enrollment != null && datum.age != null"
    },
    {
      "aggregate": [
        {"op": "mean", "as": "avg_age"},
        {"op": "sum", "as": "total_wealth"}
      ],
      "groupby": ["countryOfCitizenship", "gross_tertiary_education_enrollment"]
    }
  ],
  "mark": {"type": "circle", "opacity": 0.65, "stroke": "#333", "strokeWidth": 1},
  "encoding": {
    "x": {
      "field": "gross_tertiary_education_enrollment",
      "type": "quantitative",
      "title": "Tertiary Education Enrollment (%)"
    },
    "y": {
      "field": "avg_age",
      "type": "quantitative",
      "title": "Average Age of Billionaires",
      "scale": {"domain": [45, 85]}
    },
    "size": {
      "field": "total_wealth",
      "type": "quantitative",
      "title": "Combined Net Worth ($M)",
      "scale": {"range": [40, 700]}
    },
    "color": {
      "condition": {
        "test": "datum.countryOfCitizenship == 'Malaysia' || datum.countryOfCitizenship == 'Australia'",
        "value": "#008080"
      },
      "value": "#cfd8dc"
    },
    "tooltip": [
      {"field": "countryOfCitizenship", "type": "nominal", "title": "Country"},
      {"field": "avg_age", "type": "quantitative", "format": ".1f", "title": "Avg Age"},
      {"field": "gross_tertiary_education_enrollment", "type": "quantitative", "title": "Tertiary Enrollment %"}
    ]
  }
}
