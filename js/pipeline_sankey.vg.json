{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 400,
  "title": "Wealth Density & Outliers across Key Sectors",
  "data": {
    "url": "https://raw.githubusercontent.com/FIT3179/Vega-Lite/main/6_advanced_examples/data/Billionaires%20Statistics%20Dataset.csv"
  },
  "transform": [
    {
      "filter": "datum.category == 'Technology' || datum.category == 'Metals & Mining' || datum.category == 'Finance & Investments'"
    }
  ],
  "layer": [
    {
      "mark": {"type": "boxplot", "extent": "min-max"},
      "encoding": {
        "y": {"field": "category", "type": "nominal", "title": "Industry Sector"},
        "x": {"field": "finalWorth", "type": "quantitative", "title": "Net Worth ($ Millions)"}
      }
    }
  ]
}
