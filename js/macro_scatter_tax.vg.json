{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 380,
  "title": "Billionaire Count vs National Tax Rates",
  "data": {
    "url": "https://raw.githubusercontent.com/FIT3179/Vega-Lite/main/6_advanced_examples/data/Billionaires%20Statistics%20Dataset.csv"
  },
  "transform": [
    {
      "filter": "datum.total_tax_rate_country != null && datum.countryOfCitizenship != null"
    },
    {
      "aggregate": [{"op": "count", "as": "billionaires"}],
      "groupby": ["countryOfCitizenship", "total_tax_rate_country"]
    }
  ],
  "mark": {"type": "circle", "size": 100, "opacity": 0.7, "stroke": "#2c3e50", "strokeWidth": 1},
  "encoding": {
    "x": {
      "field": "total_tax_rate_country",
      "type": "quantitative",
      "title": "Total Tax Rate (%)"
    },
    "y": {
      "field": "billionaires",
      "type": "quantitative",
      "title": "Total Billionaire Count",
      "scale": {"type": "log"}
    },
    "color": {
      "condition": {
        "test": "datum.countryOfCitizenship == 'Malaysia' || datum.countryOfCitizenship == 'Australia'",
        "value": "#ff7f50"
      },
      "value": "#b0bec5"
    },
    "tooltip": [
      {"field": "countryOfCitizenship", "type": "nominal", "title": "Country"},
      {"field": "total_tax_rate_country", "type": "quantitative", "title": "Tax Rate %"},
      {"field": "billionaires", "type": "quantitative", "title": "Billionaires"}
    ]
  }
}
